# Database
DATABASE_URL=postgresql+psycopg://finkibot:finkibot@localhost:5432/finkibot

# LLM (chat assistant + quiz generation) — Gemini API free tier (no card needed):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Embeddings (local, no API key needed)
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Email notifier
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FinkiBOT <noreply@finkibot.local>
SMTP_USE_TLS=false

# Used to build confirmation links sent in subscription emails
APP_BASE_URL=http://localhost:8000

# Scraping
SCRAPE_USER_AGENT=FinkiBOT/0.1 (+https://github.com/finki-bot; contact: grival900@yahoo.com)
SCRAPE_REQUEST_DELAY_SECONDS=1.0
# Caps announcement scraping to the N most recent (listing is newest-first). Leave unset
# for the full board — useful to set low (e.g. 10) for a fast local/demo reindex.
SCRAPE_ANNOUNCEMENT_LIMIT=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Periodic scrape -> index -> notify job. Off by default in dev so `uvicorn --reload`
# doesn't kick off a scrape (incl. Playwright + LLM calls) on every reload.
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=60
